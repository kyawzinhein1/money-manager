{
  "name": "Personal Money Manager",
  "short_name": "Personal Money",
  "description": "Premium Liquid Glass Financial & Expense Tracker with 100% Offline PWA Capabilities",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/",
